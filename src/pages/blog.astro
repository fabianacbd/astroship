---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Sort content entries by publication date
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<Layout title="Blog">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Como seguir amigos en Instagram</Fragment>
      <Fragment slot="desc">
        Paso a paso para seguir a tus amigos y contactos en Instagram
      </Fragment>
    </Sectionhead>
    <main class="mt-16">
                <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
                <h2 class="text-3xl font-semibold leading-snug tracking-tight mt-1 ">
                Busca a tus amigos</h2>
                <Picture
                    src="./src/assets/img_3.png"
                    alt=""
                    sizes="(max-width: 800px) 100vw, 800px"
                    width={800}
                    height={600}
                    class="w-full rounded-md object-cover object-center bg-white"/>
                    <span class="text-gray-400">Encuentra la lupa en la parte de abajo de la app y dale click para buscar.</span>
                  </div>
                            <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
                            <h2 class="text-3xl font-semibold leading-snug tracking-tight mt-1 ">
                            Escribe el nombre o username de tu amigo</h2>
                            <Picture
                                src="./src/assets/image7.png"
                                alt=""
                                sizes="(max-width: 800px) 100vw, 800px"
                                width={800}
                                height={600}
                                class="w-full rounded-md object-cover object-center bg-white"/>
                                <span class="text-gray-400">Una vez hayas dado click a la lupa, preguntale a tu amigo su username o escribe su nombre y apellido para encontrarlo. Cuando hagas click en buscar debes darle a la parte de "Cuentas"</span>
                              </div>
                                                    <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
                                                    <h2 class="text-3xl font-semibold leading-snug tracking-tight mt-1 ">
                                                    Seguir a tu amigo</h2>
                                                    <Picture
                                                        src="/src/assets/image8.png"
                                                        alt=""
                                                        sizes="(max-width: 800px) 100vw, 800px"
                                                        width={800}
                                                        height={600}
                                                        class="w-full rounded-md object-cover object-center bg-white"/>
                                                        <span class="text-gray-400">Cuando hayas encontrado a tu amigo, haz click en el boton de "Seguir" y ya estaria si su usuario es publico. Si su usuario es privado, se le enviara una solicitud de amistad que debe aceptar o rechazar.</span>
                                                      </div>
    </main>
  </Container>
</Layout>
