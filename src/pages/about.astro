---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import cap1 from "@/assets/image0.png";
import cap2 from "@/assets/image1.png";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// Filter team entries with 'draft: false' & date before current date
const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Como subir una historia en Instagram</Fragment>
      <Fragment slot="desc">Aqui encontraras el paso a paso para subir tu primera historia para que puedas compartirla con todos tus amigos.</Fragment>
    </Sectionhead>

               <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
               <p className="text-center md:text-left"><b>Paso 1</b> - Buscar el simbolo de + y dale click.</p>
               <img src="./src/assets/image6.png" className="w-48 h-auto rounded-lg" alt="Paso 1" />

    </div>
<div class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
                    <p className="text-center md:text-left"><b>Paso 2</b> - Puedes escoger una foto de tu galeria o tomar una fotografia nueva en el momento con tu camara.</p>
                    <img src="./src/assets/IMG_0758.PNG" class="w-200px h-auto mt-4 rounded-lg">

      </div>
      <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
                    <p className="text-center md:text-left"><b>Paso 3</b> - Escoge la foto que quieras subir de tu galeria o toma una foto y decide si subirla a tus mejores amigos o a todos tus amigos en general. Cuando estes listo hacer click en Compartir.</p>
                    <img src="./src/assets/IMG_0761.PNG" class="w-200px h-auto mt-4 rounded-lg">

  </Container>
</Layout>
