---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";

const pricing = [
  {
    name: "Paso 1",
    price: "Registro",
    popular: false,
    features: [
      "Ingresa tu email o telefono",
      "Ingresa una contraseña",
      "Ingresa tu nombre completo",
      "Ingresa tu nombre de usuario, debe ser unico y puedes cambiarlo luego",
      "Puedes crear tu cuenta usando Facebook tambien"
    ],
    image: "src/assets/img.png"
  },
  {
    name: "Paso 2",
    price:
    {
      monthly: "Agregar tu fecha de nacimiento",
    },
    popular: true,
    features: [
      "Ingresa tu fecha de nacimiento",
      "Click en el boton siguiente",
    ],
    image: "src/assets/img_1.png"
  },
  {
    name: "Paso 3",
    price: "Ingresar codigo de confirmacion",
    popular: false,
    features: [
      "Ingresa a tu email o a tu bandeja de SMS depende de lo que hayas escogido",
      "Coloca el codigo de confirmacion que te han enviado",
      "Click en Siguiente",
    ],
    image: "src/assets/img_2.png"
  },
];
---

<Layout title="Pricing">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Pasos para registrarte en Instagram</Fragment>
      <Fragment slot="desc">
        Aprende a registrarte en instragram en menos de 5 minutos.
      </Fragment>
    </Sectionhead>

    <div
      class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
