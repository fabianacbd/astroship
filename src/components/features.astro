---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Registrate en Instagram",
    description:
      "Paso a paso para registrarte en Instagram si aun no eres parte de ella.",
    icon: "bx:bxs-briefcase",
    path: "/pricing"
  },
  {
    title: "Subir una historia en Instagram",
    description:
      "Si eres nuevo en esta red social podras aprender a subir tu primera historia en menos de 5 minutos.",
    icon: "bx:bxs-window-alt",
    path: "/about"
  },
  {
    title: "Seguir a un amigo en Instagram",
    description:
      "Aqui podras encontrar y seguir a tus seres queridos con su nombre o con su nombre de usuario y compartir tu vida con ellos.",
    icon: "bx:bxs-data",
    path: "/blog"
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Todo lo que necesitas aprender de Instagram
  </h2>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
        <a href={item.path}>
          <h3 class="font-semibold text-lg">{item.title}</h3></a>
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
